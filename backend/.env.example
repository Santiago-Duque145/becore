# --- Servidor ---
# Puerto HTTP del backend (el proxy de Vite apunta a 3000)
PORT=3000
# Entorno de ejecucion: development | production | test (opcional, por defecto development)
NODE_ENV=development
# Origen permitido por CORS: la URL del frontend (en local, http://localhost:5173)
FRONTEND_URL=http://localhost:5173
# URL publica para los enlaces de los correos. npm run demo la pone sola con la del tunel; vacia = se usa FRONTEND_URL
APP_URL=

# --- Supabase ---
# URL del proyecto de Supabase (Settings > API)
SUPABASE_URL=
# Secret key (sb_secret_...). Solo en este archivo, jamas en el frontend ni en Git
SUPABASE_SECRET_KEY=

# --- Correo (SMTP de Gmail; si falta alguno, el correo se omite con una advertencia) ---
# Servidor SMTP (smtp.gmail.com)
SMTP_HOST=
# Puerto SMTP (465 = conexion segura)
SMTP_PORT=
# Cuenta de Gmail que envia los correos
SMTP_USER=
# Contrasena de aplicacion de Google (16 caracteres), no la contrasena de la cuenta
SMTP_PASS=
# Remitente visible, por ejemplo: "Be Core <cuenta@gmail.com>"
MAIL_FROM=

# --- Recordatorios ---
# Horas antes del inicio del evento en que se envia el recordatorio (por defecto 24)
REMINDER_HOURS_BEFORE=24
# true activa el cron de recordatorios cada 15 min; false lo apaga
CRON_ENABLED=true

# --- IA / Gemini (Fase 3; reservadas: el codigo actual todavia no las lee) ---
# Clave de la API de Gemini. Solo backend, nunca en el frontend
GEMINI_API_KEY=
# Modelo de texto para etiquetar y reordenar recomendaciones (nombre vigente segun la documentacion oficial)
GEMINI_MODEL=
# Modelo de embeddings para la similitud de eventos y perfiles
GEMINI_EMBEDDING_MODEL=
# Modelo de imagenes para generar la portada del evento (requiere facturacion activa)
GEMINI_IMAGE_MODEL=
# true activa las recomendaciones con IA; false usa solo las reglas ("Para ti")
AI_ENABLED=false
# true activa la generacion de imagenes con IA; false la desactiva
AI_IMAGES_ENABLED=false
